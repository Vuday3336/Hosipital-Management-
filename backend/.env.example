# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/hospital_management

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP - e.g. Gmail App Password, Mailtrap, SendGrid SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=replace_me
EMAIL_FROM="Hospital Management System <no-reply@hms.local>"

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20

# Seed / bootstrap admin (used only by src/seed.js)
SEED_ADMIN_EMAIL=admin@hms.local
SEED_ADMIN_PASSWORD=ChangeMe123!
