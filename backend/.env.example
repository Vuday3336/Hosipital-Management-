# Server
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# Database — Supabase (Postgres). Use the "Session pooler" connection string
# (Project Settings -> Database -> Connection String -> Session pooler), NOT
# "Direct connection" — the direct connection is IPv6-only and will fail to
# connect from most hosts (including Render). The session pooler is
# IPv4-compatible and supports everything Prisma needs (migrations included),
# so this one variable covers both the app at runtime and `prisma migrate`.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP - e.g. Gmail App Password, Mailtrap, SendGrid SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=replace_me
EMAIL_FROM="Hospital Management System <no-reply@hms.local>"

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20

# Seed / bootstrap admin (used only by src/seed.js)
SEED_ADMIN_EMAIL=admin@hms.local
SEED_ADMIN_PASSWORD=ChangeMe123!
